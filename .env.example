# Lingora - CHỈ tên biến và giải thích. Không đặt giá trị thật vào tệp này.
# Thiếu biến nào thì adapter tương ứng chạy ở chế độ mock CÓ NHÃN, ứng dụng
# không sập. Xem docs/INTEGRATIONS.md.

# --- Ứng dụng -------------------------------------------------------------
LINGORA_APP_URL=            # vd http://localhost:3055 hoặc https://lingora.de
LINGORA_DEFAULT_TZ=         # mặc định Europe/Berlin
LINGORA_AUDIO_RETENTION_DAYS=   # số ngày giữ audio thô, mặc định 30
# Đặt =1 CHỈ KHI ứng dụng chạy sau proxy của chính mình (nginx trên VPS). Khi đó
# rate limit đọc x-forwarded-for để phân biệt từng người dùng. Bật nhầm lúc ứng
# dụng phơi thẳng ra Internet là mở đường cho việc giả IP để vượt mọi hạn mức.
LINGORA_TRUST_PROXY=
# Đặt =0 để TẠM TẮT bước xác minh email, dùng khi chưa nối được máy chủ gửi thư:
# bắt người ta bấm vào một lá thư không bao giờ tới là cách nhanh nhất để họ bỏ
# đi. Tắt cờ này KHÔNG đánh dấu tài khoản là đã xác minh - dữ liệu vẫn ghi đúng
# sự thật, chỉ là giao diện không nhắc nữa. Nhớ rằng lúc tắt thì "quên mật khẩu"
# cũng không dùng được, vì nó đi qua chính đường thư đó.
LINGORA_YEU_CAU_XAC_MINH_EMAIL=

# --- Cơ sở dữ liệu --------------------------------------------------------
DATABASE_URL=               # chuỗi kết nối Postgres. BỎ TRỐNG khi dev -> dùng PGlite
PGLITE_DATA_DIR=            # thư mục dữ liệu PGlite, mặc định ./data/pgdata

# --- Mô hình ngôn ngữ (giảng dạy, chấm bài) ------------------------------
# MẶC ĐỊNH LÀ TỰ HOST: llama.cpp chạy trên máy chủ của trường, phơi ra theo
# chuẩn OpenAI. Không có khóa nào phải mua, không tính tiền theo lượt.
LINGORA_LLM_URL=            # vd http://127.0.0.1:8080/v1
LINGORA_LLM_TOKEN=          # để trống nếu dịch vụ chỉ nghe trên localhost
LINGORA_LLM_MODEL=          # tên model engine đang nạp, vd qwen2.5-7b-instruct
# Chỉ dùng khi chủ dự án chọn trả tiền cho dịch vụ ngoài thay vì tự host:
ANTHROPIC_API_KEY=

# --- Giọng nói tiếng Đức (đọc và nghe) -----------------------------------
# Cũng TỰ HOST: piper (đọc) + whisper.cpp (nghe) sau một dịch vụ HTTP nhỏ.
# Thiếu hai biến này thì phần Nghe rơi về giọng đọc sẵn của trình duyệt và
# được dán nhãn đúng như vậy.
LINGORA_VOICE_URL=          # vd http://127.0.0.1:3600
LINGORA_VOICE_TOKEN=        # token của engine, đọc trên máy chủ trong /etc/vd-voice.env

# --- Avatar đồng bộ khẩu hình (tùy chọn) ---------------------------------
LINGORA_AVATAR_PROVIDER=
LINGORA_AVATAR_KEY=

# --- Đăng nhập bằng Google ------------------------------------------------
# Tạo OAuth client dạng "Web application" trong Google Cloud Console, rồi thêm
# https://<tên miền>/api/auth/google/callback vào Authorized redirect URIs.
# Thiếu hai biến này: ở máy dev nút Google chạy bản MÔ PHỎNG có nhãn; trên
# production nút bị vô hiệu kèm lý do, không có màn hình giả nào.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email giao dịch ------------------------------------------------------
# "sendmail" = máy chủ thư của chính VPS (postfix + DKIM, dựng bằng
# scripts/vps/may-chu-thu.sh). Không cần khoá. Để trống = mock, thư ghi ra
# data/outbox/ và KHÔNG gửi đi đâu.
LINGORA_MAIL_PROVIDER=      # vd sendmail
LINGORA_MAIL_KEY=           # chỉ cho nhà cung cấp gửi qua API
LINGORA_MAIL_FROM=          # vd Việt Đức Lingua <no-reply@vietduc-lingua.com>

# --- Thanh toán -----------------------------------------------------------
# CÁCH MẶC ĐỊNH LÀ CHUYỂN KHOẢN: không cần cổng thanh toán, không mất phần trăm,
# và trường đã có sẵn tài khoản ngân hàng. Thiếu ba biến này thì trang gói học
# không hiện thông tin chuyển khoản nào cả - không bịa ra số tài khoản.
LINGORA_BANK_HOLDER=        # tên chủ tài khoản, mặc định lấy tên pháp nhân
LINGORA_BANK_NAME=          # tên ngân hàng
LINGORA_BANK_IBAN=          # số tài khoản hoặc IBAN

# Cổng thẻ và PayPal chỉ cần khi chủ trường mở thêm cách trả tiền. Chúng KHÔNG
# tự dựng được: phải có tài khoản thương gia đứng tên pháp nhân.
PAYPAL_ENV=                 # sandbox hoặc live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Nhà cung cấp thẻ (Visa) - điền sau khi chốt provider, xem docs/INTEGRATIONS.md
CARD_PROVIDER=
CARD_API_KEY=
CARD_WEBHOOK_SECRET=

# --- Lưu trữ audio/asset --------------------------------------------------
LINGORA_STORAGE_DRIVER=     # local (mặc định) hoặc s3
LINGORA_S3_BUCKET=
LINGORA_S3_REGION=
LINGORA_S3_ENDPOINT=
LINGORA_S3_ACCESS_KEY=
LINGORA_S3_SECRET_KEY=
